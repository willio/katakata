APP_NAME=Katakata
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Fallback secret for newsletter/analytics signing when dedicated secrets are unset.
APP_KEY=

NEWSLETTER_SECRET=
# Salt for the daily-rotating analytics visitor hash; falls back to APP_KEY.
ANALYTICS_SECRET=
MAIL_TRANSPORT=filesystem
MAIL_FROM="Katakata <admin@katakata.example>"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Optional Threads discussion/distribution integration; disabled when unset.
THREADS_ENABLED=false
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Deployment-only IMAP settings. Keep credentials in .env or the host secret manager.
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Production values for katakata.example:
# APP_URL=https://katakata.example
# MAIL_TRANSPORT=resend
