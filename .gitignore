/graphify-out/

# Per-machine local TLS material for config/nginx/katakata.conf.
config/nginx/ssl/*
!config/nginx/ssl/.gitkeep
.env.*
!.env.example

# --------------------------------------------------
# Runtime
# --------------------------------------------------

/storage/settings/*
!/storage/settings/.gitkeep

/storage/cache/*
!/storage/cache/.gitkeep

/storage/index/*
!/storage/index/.gitkeep

/storage/analytics/*
!/storage/analytics/.gitkeep

/storage/logs/*
!/storage/logs/.gitkeep

/storage/queue/*
!/storage/queue/.gitkeep

/storage/sessions/*
!/storage/sessions/.gitkeep

/storage/tmp/*
!/storage/tmp/.gitkeep

