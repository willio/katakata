{
    "name": "katakata/katakata",
    "description": "A calm, typography-first publishing platform built around plain Markdown files.",
    "type": "project",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.5",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Katakata\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Katakata\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php bin/katakata serve"
    },
    "config": {
        "sort-packages": true
    }
}
